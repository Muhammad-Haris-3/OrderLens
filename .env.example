# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Neon Postgres connection string for the OrderLens warehouse (https://neon.tech).
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Use the DIRECT endpoint — remove "-pooler" from the host if present.
DATABASE_URL=

# dbt reads these to build the same connection.
# Split out from DATABASE_URL because dbt's postgres adapter wants discrete fields.
DBT_HOST=
DBT_USER=
DBT_PASSWORD=
DBT_DBNAME=
DBT_SCHEMA=analytics
DBT_PORT=5432
